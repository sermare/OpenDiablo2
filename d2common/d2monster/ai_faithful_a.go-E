package d2monster

import "math"

// Faithful ports of the monai.txt AIs whose name sorts A..M (case
// insensitive, "7TIllusion" first), replacing the generic stand-ins of
// ai_rest.go. Each function is a port of the exe think function named in its
// comment (Game.exe 1.14b VAs, read with the read-only Ghidra tools): the
// decision logic, the aip1..aip8 columns, the order of the per-monster RNG
// draws and the AiGeneral scratch fields (Scratch[0..2] = +0x14, +0x18, +0x1c).
//
// Conventions of the decompilation (monster-ai-2.md section 0): aipN[diff] is
// the monstats column, "roll(100) < aipN" is Chance(aipN), the unnamed
// RAND_RollSeedBounded arguments are 100 for percent tests (VERIFIED in the
// Baboon disassembly, where the few exceptions are roll(5) and roll(100)).
// Calls the world cannot express are optional host interfaces below; without
// them the call is skipped, which is noted per function. ai_faithful_a.go
// sorts before ai_rest.go, so its init registers first and the stand-ins in
// ai_rest.go skip these names.

// slotA, slotB, slotC are the monstats Skill1..3 slots.
const (
	slotA = 0
	slotB = 1
	slotC = 2
)

// UnitStatter reads and writes a unit stat by ItemStatCost id (Baboon rage
// uses stat 0x4a).
type UnitStatter interface {
	UnitStat(b *Brain, id int) int
	SetUnitStat(b *Brain, id, v int)
}

// TargetStateReader reports whether a target unit has a state
// (STATE_UnitHasState on the target, FingerMage checks 0x54).
type TargetStateReader interface {
	TargetHasState(b *Brain, t Target, state int) bool
}

// SkillGate is MONAI_CanCastSkillAtTarget for a monstats slot (ClawViper);
// absent means "can cast".
type SkillGate interface {
	CanCast(b *Brain, slot int, t Target) bool
}

// SelfKiller kills the monster the way COMBAT_ServerHandleUnitDeath(unit, 1)
// does (ElementalBeast and MaggotEgg after their last phase). Without it the
// Dismisser is used, then the brain mode is set to dying.
type SelfKiller interface {
	KillSelf(b *Brain)
}

// SpawnSpace is MONSTER_AreSpawnerCellsFree at the monster's own tile (the
// nests); absent means free.
type SpawnSpace interface {
	SpawnerCellsFree(b *Brain) bool
}

// MinionCounter is the MinionSpawner scan callback: how many of its minions
// live (MONAI_MinionSpawner_FilterUnit); absent means none.
type MinionCounter interface {
	CountMinions(b *Brain) int
}

// DurationSource gives the lifetime in frames of the monster's Skill1 summon
// (skills.txt +0x14c, BoneWall pre-hook); absent means the summon never
// expires on its own.
type DurationSource interface {
	SkillDuration(b *Brain, slot int) int
}

// RiteOfPassage is the Act 5 Ancients quest state (QUEST_A5_RiteOfPassage_*).
type RiteOfPassage interface {
	AncientFightActive() bool
	FightDone() bool
	PortalCount() int
}

// ------------------------------------------------------------------ helpers

func (c *Ctx) self() Target { return Target{X: c.B.X, Y: c.B.Y, Size: c.B.Size} }

// skill reports a used monstats slot (Skill id >= 0 in the exe).
func (c *Ctx) skill(slot int) bool { return c.B.Profile.Skills[slot].Used() }

// speedBoost is the run/walk velocity excess the chasers hand to
// MONAI_SetMoveSpeedOverride: (Run*100/Velocity) - 100 clamped to 0..0x78
// (VERIFIED in Baboon/FingerMage; which record fields +0x32/+0x34 are is
// UNVERIFIED, taken as Velocity and Run).
func (p *Profile) speedBoost() int {
	if p.Walk < 1 {
		return 0
	}

	r := p.Run*100/p.Walk - 100
	if r < 1 {
		return 0
	}

	if r > 0x78 {
		return 0x78
	}

	return r
}

// die is "set unit flag 0x20000 and queue mode 0 (death)", the way timed
// summons and nests end themselves.
func (c *Ctx) die() {
	c.busy()

	switch w := c.W.(type) {
	case SelfKiller:
		w.KillSelf(c.B)
	case Dismisser:
		w.Dismiss(c.B)
	default:
		c.B.Mode = ModeDying
	}
}

func (c *Ctx) setState(state int, on bool) {
	if s, ok := c.W.(StateSetter); ok {
		s.SetUnitState(c.B, state, on)
	}
}

// walkNoTarget is MONAI_WalkNoTarget 0x5ddac0: queue a walk with neither
// coordinates nor a unit to path to. The port walks to the target (UNVERIFIED).
func (c *Ctx) walkNoTarget(t Target) bool { return c.WalkTo(t, 0) }

// pre runs a pre-hook once, at the first think after SetAI (the exe runs it
// from MONAI_SetAiState).
func (c *Ctx) pre(f func()) {
	if !c.B.preRan {
		c.B.preRan = true

		f()
	}
}

func (c *Ctx) frame() int { return c.W.Frame() }

func (c *Ctx) otherCanCast(slot int, t Target) bool {
	if g, ok := c.W.(SkillGate); ok {
		return g.CanCast(c.B, slot, t)
	}

	return true
}

func (c *Ctx) townRoom() bool {
	if g, ok := c.W.(TownChecker); ok {
		return g.InTown(c.B)
	}

	return false
}

func (c *Ctx) spawnSpace() bool {
	if g, ok := c.W.(SpawnSpace); ok {
		return g.SpawnerCellsFree(c.B)
	}

	return true
}

func faTarget(c *Ctx) Target {
	if c.Target != nil {
		return *c.Target
	}

	return c.self()
}

func init() {
	for name, think := range map[string]Think{
		"7TIllusion":     think7TIllusion,
		"Ancient":        thinkAncient,
		"AncientStatue":  thinkAncientStatue,
		"Arach":          thinkArach,
		"ArcaneTower":    thinkArcaneTower,
		"Baboon":         thinkBaboon,
		"BloodHawk":      thinkBloodHawk,
		"BloodLord":      thinkBloodLord,
		"BoneWall":       thinkBoneWall,
		"Buffy":          thinkBuffy,
		"Catapult":       thinkCatapult,
		"ClawViper":      thinkClawViper,
		"ClawViperEx":    thinkClawViperEx,
		"CorruptLancer":  thinkCorruptLancer,
		"DeathMauler":    thinkDeathMauler,
		"ElementalBeast": thinkElementalBeast,
		"FingerMage":     thinkFingerMage,
		"FlyingScimitar": thinkFlyingScimitar,
		"FoulCrowNest":   thinkFoulCrowNest,
		"FrozenHorror":   thinkFrozenHorror,
		"GoodNpcRanged":  thinkGoodNpcRanged,
		"HellMeteor":     thinkHellMeteor,
		"Hydra":          thinkHydra,
		"InvisoPet":      thinkInvisoPet,
		"MaggotEgg":      thinkMaggotEgg,
		"MaggotLarva":    thinkMaggotLarva,
		"MinionSpawner":  thinkMinionSpawner,
		"Mosquito":       thinkMosquito,
		"MosquitoNest":   thinkMosquitoNest,
	} {
		register(name, standInMode(name), think)
	}
}

// FaithfulA lists the names ported in this file, for tests and tooling.
func FaithfulA() []string {
	return []string{"7TIllusion", "Ancient", "AncientStatue", "Arach", "ArcaneTower", "Baboon", "BloodHawk",
		"BloodLord", "BoneWall", "Buffy", "Catapult", "ClawViper", "ClawViperEx", "CorruptLancer", "DeathMauler",
		"ElementalBeast", "FingerMage", "FlyingScimitar", "FoulCrowNest", "FrozenHorror", "GoodNpcRanged",
		"HellMeteor", "Hydra", "InvisoPet", "MaggotEgg", "MaggotLarva", "MinionSpawner", "Mosquito", "MosquitoNest"}
}

// ------------------------------------------------------------------- Baboon

// thinkBaboon is MONAI_Think_Baboon 0x5efd80 (VERIFIED from decompilation and
// disassembly). Scratch[0] (+0x14) is the rage countdown, Scratch[1] (+0x18)
// "just attacked", Scratch[2] (+0x1c) the stat 0x4a bonus to take back.
// aip1 flee below this life %, aip2 circle %, aip3 attack %, aip4 A1-vs-A2 %,
// aip5 rage stat bonus (eighths).
func thinkBaboon(c *Ctx) {
	b, t := c.B, *c.Target
	s := &b.Scratch
	life := b.HPPercent
	boost := b.Profile.speedBoost()
	st, _ := c.W.(UnitStatter)

	if s[0] == 0 {
		if !c.InRange {
			c.SetSpeed(0)
			c.WalkTo(t, meleeReach)

			return
		}

		if b.Aggressive {
			if life < b.AIP(1) && b.Chance(50) {
				s[0] = b.Roll(5) + 2

				v := 0
				if st != nil {
					v = st.UnitStat(b, 0x4a)
				}

				if v == 0 {
					s[2] = 0
				} else {
					x := b.AIP(5) * v
					s[2] = (x + (x >> 31 & 7)) >> 3
					st.SetUnitStat(b, 0x4a, s[2]+v)
				}

				c.SetSpeed(boost)
				c.WalkAway(t, 0xf, false)

				return
			}

			if s[1] != 0 && b.Chance(20) {
				c.Circle(t, 3)
				s[1] = 0

				return
			}
		}

		if s[1] != 0 && b.Roll(100) >= b.AIP(3) {
			if b.Chance(b.AIP(2)) {
				c.Circle(t, 3)
				s[1] = 0
			}

			c.Sleep(15)

			return
		}

		s[1] = 1
		attackA1orA2(c, t, b.AIP(4))

		return
	}

	// raging: count down, end the rage when it runs out or life recovered
	s[0]--
	s[1] = 0

	if s[0] == 0 || life > 75 {
		if st != nil {
			st.SetUnitStat(b, 0x4a, st.UnitStat(b, 0x4a)-s[2])
		}
	}

	if !c.InRange {
		if life > 75 {
			s[0] = 0
			c.SetSpeed(boost)
			c.WalkTo(t, meleeReach)

			return
		}
	} else if b.Chance(33) {
		attackA1orA2(c, t, b.AIP(4))

		return
	}

	if c.Dist >= 24 && !b.Aggressive {
		if b.Chance(33) {
			c.Circle(t, 4)
		}

		c.Sleep(20)

		return
	}

	c.SetSpeed(boost)

	if c.WalkAway(t, 0xf, true) {
		return
	}

	if !c.InRange {
		c.Wander(5)

		return
	}

	attackA1orA2(c, t, b.AIP(4))
}

// ----------------------------------------------------------------- ClawViper

func clawViperToggle(c *Ctx, on bool) {
	switch c.B.AIP(6) {
	case 0:
	case 2:
		c.setState(0x5b, on)
	default:
		c.setState(0x5a, on)
	}
}

// thinkClawViper is MONAI_Think_ClawViper 0x5f0bd0 (VERIFIED). Scratch[0] is
// "buff cast". aip1 cast %, aip2 cast range, aip3 attack %, aip4 A1-vs-A2 %,
// aip5 stall ticks, aip6 buff state (1: 0x5a, 2: 0x5b).
func thinkClawViper(c *Ctx) {
	b, t := c.B, *c.Target

	if b.Scratch[0] != 0 {
		clawViperToggle(c, false)
	}

	if !c.InRange {
		if c.skill(slotA) && c.Dist < b.AIP(2) && b.Chance(b.AIP(1)) && c.otherCanCast(slotA, t) {
			if c.Cast(slotA, t) {
				clawViperToggle(c, true)
				b.Scratch[0] = 1
			}

			return
		}

		if b.Chance(50) {
			c.WalkTo(t, meleeReach)

			return
		}

		c.Sleep(b.AIP(5))

		return
	}

	if b.Roll(100) >= b.AIP(3) {
		c.Sleep(b.AIP(5))

		return
	}

	attackA1orA2(c, t, b.AIP(4))
}

// thinkClawViperEx is MONAI_Think_ClawViperEx 0x5f0e40 (VERIFIED). Scratch[1]
// is the frame the next A1 may start. aip1/aip2 cast % and range, aip3 A2 %,
// aip4 A1 %, aip5 stall, aip6 buff state, aip7 A1 range, aip8 A1 cooldown.
func thinkClawViperEx(c *Ctx) {
	b, t := c.B, *c.Target

	if b.Scratch[0] != 0 {
		clawViperToggle(c, false)
	}

	if c.InRange {
		if b.Chance(b.AIP(3)) {
			c.Attack(ModeAttack2, t)

			return
		}

		c.Sleep(b.AIP(5))

		return
	}

	if c.Dist < b.AIP(7) && b.Chance(b.AIP(4)) {
		if b.Scratch[1] < c.frame() {
			c.Attack(ModeAttack1, t)
			b.Scratch[1] = b.AIP(8) + c.frame()

			return
		}

		c.Sleep(b.AIP(5))

		return
	}

	if c.skill(slotA) && c.Dist < b.AIP(2) && b.Chance(b.AIP(1)) && c.otherCanCast(slotA, t) {
		if c.Cast(slotA, t) {
			clawViperToggle(c, true)
			b.Scratch[0] = 1
		}

		return
	}

	if b.Chance(50) {
		c.WalkTo(t, meleeReach)

		return
	}

	c.Sleep(b.AIP(5))
}

// --------------------------------------------------------------------- Arach

// thinkArach is MONAI_Think_Arach 0x5f3590 (VERIFIED). Scratch[0] (+0x14) is
// the phase (1: wounded, backing off), Scratch[1] "rushing", Scratch[2] a
// wander counter. aip1 attack %, aip2 circle %, aip3 charge %, aip4 back-off
// range, aip5 wounded life %.
func thinkArach(c *Ctx) {
	b, t := c.B, *c.Target
	s := &b.Scratch
	life := b.HPPercent

	if s[0] == 1 {
		s[1] = 0

		if life > 75 {
			s[0] = 0

			if b.Chance(b.AIP(3)) {
				s[0] = 2
				c.SetSpeed(0)
				c.WalkTo(t, 0)

				return
			}

			c.Circle(t, 6)

			return
		}

		if c.InRange && b.AIP(1) > 25 && b.Roll(100) < b.AIP(1)-25 {
			c.Attack(ModeAttack1, t)

			return
		}

		if c.Dist >= b.AIP(4) && !b.Aggressive {
			s[0] = 0
			c.Circle(t, 12)

			return
		}

		c.WalkAway(t, 4, false)

		return
	}

	if !c.InRange {
		if b.Aggressive || s[1] == 1 {
			s[1] = 1
			c.SetSpeed(0)
			c.WalkTo(t, 0)

			return
		}

		s[2]++
		if s[2] > 20 {
			s[2] = 0
		}

		s[1] = 0

		if s[2] == 1 && b.Chance(b.AIP(3)) {
			s[1] = 1
			c.SetSpeed(0)
			c.WalkTo(t, 0)

			return
		}

		if b.Chance(20) {
			c.Wander(6)

			return
		}

		c.Sleep(15)

		return
	}

	s[0] = 2

	if b.Roll(100) >= b.AIP(1) {
		if life >= b.AIP(5) {
			if b.Chance(b.AIP(2)) {
				c.Circle(t, 4)

				return
			}

			c.Sleep(15)

			return
		}

		s[0] = 1

		if c.skill(slotA) && !c.W.HasState(b, 0x16) {
			c.Cast(slotA, c.self())

			return
		}

		c.WalkAway(t, 8, false)

		return
	}

	c.Attack(ModeAttack1, t)
}

// --------------------------------------------------------------- ArcaneTower

// thinkArcaneTower is MONAI_Think_ArcaneTower 0x5dfdc0 (VERIFIED). Scratch[0]
// (+0x14) 1 while in the skill volley, Scratch[1] shots left in the volley,
// Scratch[2] the frame of the next shot. aip1 attacks per volley, aip2 gap
// between skill shots, aip3 pause after the skill volley, aip4 skill shots,
// aip5 pause after the attack volley, aip6 gap between attacks.
func thinkArcaneTower(c *Ctx) {
	b, t := c.B, faTarget(c)
	s := &b.Scratch
	now := c.frame()

	if s[1] == 0 {
		s[1] = b.AIP(1)
	}

	if now < s[2] {
		c.Sleep(10)

		return
	}

	if c.skill(slotA) && s[0] == 0 {
		c.Cast(slotA, t)

		s[1]--
		if s[1] < 1 {
			s[0] = 1
			s[1] = b.AIP(4)
			s[2] = b.AIP(3) + now

			return
		}

		s[2] = b.AIP(2) + now

		return
	}

	c.Attack(ModeAttack1, t)

	s[1]--
	if s[1] < 1 {
		s[0] = 0
		s[1] = b.AIP(1)
		s[2] = b.AIP(5) + now

		return
	}

	s[2] = b.AIP(6) + now
}

// ----------------------------------------------------------------- BloodHawk

// thinkBloodHawk is MONAI_Think_BloodHawk 0x5ef1f0 (VERIFIED). Scratch[0]
// is "dived at the target". aip1 dive %, aip2 wander-away %, aip3 attack %,
// aip4 retreat speed, aip5 dive speed.
func thinkBloodHawk(c *Ctx) {
	b, t := c.B, *c.Target
	s := &b.Scratch

	if s[0] == 1 && c.InRange {
		s[0] = 0
		c.Attack(ModeAttack1, t)

		return
	}

	s[0] = 0

	retreat := b.AIP(4)

	if !c.InRange {
		if b.Chance(b.AIP(1)) {
			c.SetSpeed(b.AIP(5))
			s[0] = 1
			c.WalkTo(t, 0)

			return
		}

		if c.Dist > 3 {
			if b.Roll(100) >= b.AIP(2) {
				c.SetSpeed(0)
				c.Wander(3)

				return
			}

			c.SetSpeed(-50)
			c.Wander(4)

			return
		}
	} else if b.Chance(b.AIP(3)) {
		c.Attack(ModeAttack1, t)

		return
	}

	c.SetSpeed(retreat)

	if c.WalkAway(t, 4, true) {
		return
	}

	c.Attack(ModeAttack1, t)
}

// ----------------------------------------------------------------- BloodLord

// thinkBloodLord is MONAI_Think_BloodLord 0x5e25e0 (VERIFIED). aip1 act %,
// aip2 approach %, aip3 skill %, aip4 stall ticks. The skill is cast with the
// fixed mode 5 in the exe (the port uses the slot's own mode, UNVERIFIED).
func thinkBloodLord(c *Ctx) {
	b, t := c.B, *c.Target

	if !c.InRange {
		if b.Chance(b.AIP(2)) {
			c.walkNoTarget(t)

			return
		}

		c.Sleep(b.AIP(4))

		return
	}

	if b.Chance(b.AIP(1)) {
		if b.Chance(b.AIP(3)) {
			if c.skill(slotA) {
				c.Cast(slotA, t)
			} else {
				c.Attack(ModeAttack2, t)
			}

			return
		}

		c.Attack(ModeAttack1, t)

		return
	}

	c.Sleep(b.AIP(4))
}

// ------------------------------------------------------------------ BoneWall

// thinkBoneWall is MONAI_Think_BoneWall 0x5df210 (VERIFIED, disassembled): when
// the expiry frame (Scratch[0], set by the pre-hook 0x5df1a0 to the frame plus
// the Skill1 duration) has passed it dies, else it sleeps 15. Without a
// DurationSource the wall has no expiry (a deliberate gap: the duration is a
// skills.txt value the port has no access to).
func thinkBoneWall(c *Ctx) {
	b := c.B

	c.pre(func() {
		if d, ok := c.W.(DurationSource); ok && c.skill(slotA) {
			b.Scratch[0] = c.frame() + d.SkillDuration(b, slotA)
		} else {
			b.Scratch[0] = math.MaxInt32
		}
	})

	if b.Scratch[0] < c.frame() {
		c.die()

		return
	}

	c.Sleep(15)
}

// -------------------------------------------------------------------- Buffy

// thinkBuffy is MONAI_Think_Buffy 0x5e6e40 (VERIFIED): wait 200 ticks (only
// when the unit has a room; the owner does not tick monsters without one).
func thinkBuffy(c *Ctx) { c.Sleep(200) }

// ----------------------------------------------------------------- Catapult

// thinkCatapult is MONAI_Think_Catapult 0x5e23c0 (VERIFIED): A1 without a
// target with chance aip1, else sleep 15.
func thinkCatapult(c *Ctx) {
	if c.B.Chance(c.B.AIP(1)) {
		c.Attack(ModeAttack1, Target{})

		return
	}

	c.Sleep(15)
}

// ------------------------------------------------------------ CorruptLancer

// thinkCorruptLancer is MONAI_Think_CorruptLancer 0x5f4e50 (VERIFIED).
// Scratch[0] is "charging". aip1 approach %, aip2 attack %, aip3 stall,
// aip4 walk-vs-run %, aip5 charge distance, aip6/7/8 Skill1/2/3 %. The stop
// distance of the "run to target within" is the monstats2 byte +0xe
// (Profile.ChaseReach, UNVERIFIED meaning).
func thinkCorruptLancer(c *Ctx) {
	b, t := c.B, *c.Target
	s := &b.Scratch

	if c.Dist > b.AIP(5) {
		c.SetSpeed(100)
		c.RunTo(t, b.Profile.ChaseReach)

		s[0] = 1

		return
	}

	if c.InRange {
		if s[0] != 0 || b.Roll(100) < b.AIP(2) {
			s[0] = 0

			if c.skill(slotA) && b.Roll(100) < b.AIP(6) {
				c.Cast(slotA, t)

				return
			}

			if c.skill(slotB) && b.Roll(100) < b.AIP(7) {
				c.Cast(slotB, t)

				return
			}

			if c.skill(slotC) && b.Roll(100) < b.AIP(8) {
				c.Cast(slotC, t)

				return
			}

			c.Attack(ModeAttack1, t)

			return
		}

		c.Sleep(b.AIP(3))

		return
	}

	if b.Roll(100) >= b.AIP(1) {
		c.Sleep(b.AIP(3))

		return
	}

	if b.Roll(100) >= b.AIP(4) {
		c.WalkTo(t, 3)

		return
	}

	c.SetSpeed(100)
	c.RunTo(t, b.Profile.ChaseReach)
}

// -------------------------------------------------------------- DeathMauler

// thinkDeathMauler is MONAI_Think_DeathMauler 0x5ed390 (VERIFIED). aip1 attack
// %, aip2 approach %, aip3 skill range, aip4 skill %.
func thinkDeathMauler(c *Ctx) {
	b, t := c.B, *c.Target

	if !c.InRange {
		if c.skill(slotA) && c.Dist < b.AIP(3) && b.Chance(b.AIP(4)) {
			c.Cast(slotA, t)

			return
		}

		if b.Chance(b.AIP(2)) {
			c.WalkTo(t, 0)

			return
		}
	} else if b.Chance(b.AIP(1)) {
		c.Attack(ModeAttack1, t)

		return
	}

	c.Sleep(15)
}

// ----------------------------------------------------------- ElementalBeast

// thinkElementalBeast is MONAI_Think_ElementalBeast 0x5f5c10 (VERIFIED).
// Scratch[0]: 0 hunting, 1 exploding (S1 animation queued), 2 dies next tick.
// aip1 approach %, aip2 explode range, aip3 stall.
func thinkElementalBeast(c *Ctx) {
	b, t := c.B, *c.Target
	s := &b.Scratch

	if s[0] == 2 {
		c.die()

		return
	}

	if s[0] == 0 && (c.Dist < b.AIP(2) || b.Aggressive) {
		c.Attack(ModeSkill1, t)

		s[0] = 1

		return
	}

	if s[0] != 1 {
		c.Sleep(b.AIP(3))

		return
	}

	if c.InRange {
		c.Attack(ModeSkill1, t)

		b.Wake = c.frame() + 1 // EVENT_ScheduleEventNoDelay(0, frame+1)
		s[0] = 2

		return
	}

	if b.Roll(100) >= b.AIP(1) {
		c.Wander(8)

		return
	}

	c.WalkTo(t, 0)
}

// --------------------------------------------------------------- FingerMage

// thinkFingerMage is MONAI_Think_FingerMage 0x5f94e0 (VERIFIED). Scratch[0]
// (+0x14) 1 while fleeing, Scratch[1] the flee tick counter. aip1 attack %,
// aip2 cast %, aip3 flee-ok life %, aip4 start-flee life %, aip5 cast range,
// aip6 flee ticks, aip7 approach range, aip8 stall.
func thinkFingerMage(c *Ctx) {
	b, t := c.B, *c.Target
	s := &b.Scratch
	life := b.HPPercent
	boost := b.Profile.speedBoost()

	if b.Aggressive {
		s[0] = 0

		if c.InRange {
			c.Attack(ModeAttack1, t)

			return
		}

		if c.skill(slotA) && c.Dist < b.AIP(5) {
			c.Cast(slotA, t)

			return
		}
	}

	if s[0] == 1 {
		s[1]++

		if life <= b.AIP(3) && b.Roll(100) > 24 && s[1] <= b.AIP(6) {
			if c.Dist < 14 {
				c.SetSpeed(boost)
				c.WalkAway(t, 14, false)

				return
			}
		} else {
			s[0] = 0
		}

		c.Sleep(15)

		return
	}

	if b.Leader == nil && life < b.AIP(4) {
		s[1] = 0
		s[0] = 1

		c.WalkAway(t, 9, false)

		return
	}

	if c.InRange {
		if b.Chance(b.AIP(1)) {
			c.Attack(ModeAttack1, t)

			return
		}

		if c.skill(slotA) && b.Roll(100) < b.AIP(2) {
			c.Cast(slotA, t)

			return
		}

		c.Circle(t, 5)

		return
	}

	if c.Dist < b.AIP(5) {
		if c.skill(slotA) && b.Roll(100) < b.AIP(2) {
			c.Cast(slotA, t)

			return
		}

		if r, ok := c.W.(TargetStateReader); ok && r.TargetHasState(b, t, 0x54) {
			c.WalkTo(t, 0)

			return
		}

		c.Sleep(b.AIP(8))

		return
	}

	if c.Dist < b.AIP(7) {
		c.WalkTo(t, meleeReach)

		return
	}

	c.Sleep(15)
}

// ----------------------------------------------------------- FlyingScimitar

// thinkFlyingScimitar is MONAI_Think_FlyingScimitar 0x5f5d30 (VERIFIED). The
// branch flag is the tick's in-range flag. aip1 approach %, aip2 attack %,
// aip3 stall, aip4 circle %.
func thinkFlyingScimitar(c *Ctx) {
	b, t := c.B, *c.Target

	if !c.InRange {
		if b.Chance(b.AIP(1)) {
			c.WalkToRange(t, 8, 1)

			return
		}

		if b.Chance(b.AIP(1)) {
			c.WalkTo(t, meleeReach)

			return
		}
	} else {
		if b.Chance(b.AIP(2)) {
			c.Attack(ModeAttack1, t)

			return
		}

		if b.Chance(b.AIP(4)) {
			c.Circle(t, 2)

			return
		}
	}

	c.Sleep(b.AIP(3))
}

// ------------------------------------------------------------- FoulCrowNest

// thinkFoulCrowNest is MONAI_Think_FoulCrowNest 0x5f5730 with the shared
// spawner pre-hook 0x5f5710 (frame -> Scratch[0], 0 -> Scratch[1]) (VERIFIED).
// aip1 spawn gap in frames, aip3 spawn limit.
func thinkFoulCrowNest(c *Ctx) {
	b, t := c.B, faTarget(c)
	s := &b.Scratch

	c.pre(func() { s[0], s[1] = c.frame(), 0 })

	if c.Dist > 20 {
		c.Sleep(25)

		return
	}

	if s[1] >= b.AIP(3) {
		c.die()

		return
	}

	gap := c.frame() - s[0]
	if gap < 0 {
		gap = -gap
	}

	if c.skill(slotA) && b.AIP(1) <= gap {
		s[0] = c.frame()

		if c.spawnSpace() {
			s[1]++
			c.Cast(slotA, t)

			return
		}
	}

	// 20 + (step mod 10): the exe computes lo + (2 - lo/10)*10 on the raw step
	c.Sleep(20 + int(b.Seed.Step()%10))
}

// ------------------------------------------------------------- FrozenHorror

// thinkFrozenHorror is MONAI_Think_FrozenHorror 0x5e2430 (VERIFIED).
// Scratch[0] is the freeze counter the Skill1 uses (it is compared with the
// skill level, Profile.Skills[0].Level here), state 0xc the freeze aura state.
// aip1 attack %, aip2 approach %, aip3 skill %, aip4 stall.
func thinkFrozenHorror(c *Ctx) {
	b, t := c.B, *c.Target

	lvl := 0
	if c.skill(slotA) && b.Profile.Skills[slotA].Level > 0 {
		lvl = b.Profile.Skills[slotA].Level
	}

	if c.skill(slotA) && b.Scratch[0] < lvl && b.Chance(b.AIP(3)) && !c.W.HasState(b, 0xc) {
		c.Cast(slotA, t)

		return
	}

	if c.W.HasState(b, 0xc) {
		c.setState(0xc, false)
	}

	if !c.InRange {
		if b.Chance(b.AIP(2)) {
			c.walkNoTarget(t)

			return
		}
	} else if b.Chance(b.AIP(1)) {
		c.Attack(ModeAttack1, t)

		return
	}

	c.Sleep(b.AIP(4))
}

// ------------------------------------------------------------ GoodNpcRanged

// goodNpcRangedClass is the class id (0x10f) that casts its Skill1 instead of
// its A1 (VERIFIED immediate).
const goodNpcRangedClass = 0x10f

// thinkGoodNpcRanged is MONAI_Think_GoodNpcRanged 0x5e69e0 (VERIFIED): town
// guards (Hratli's bodyguards, Deckard-era rogues) shoot what they see when
// outside a town room.
func thinkGoodNpcRanged(c *Ctx) {
	b := c.B

	if b.Mode != ModeNeutral {
		c.Sleep(5)

		return
	}

	if !c.townRoom() {
		t, d, ok := c.W.AttackTarget(b)
		if ok && d < 20 {
			if b.Chance(30) {
				if b.Class == goodNpcRangedClass {
					c.Cast(slotA, t)
				} else {
					c.Attack(ModeAttack1, t)
				}

				return
			}

			if b.Chance(30) {
				c.Circle(t, 4)

				return
			}

			c.Sleep(10)

			return
		}
	}

	if b.Chance(20) {
		c.Wander(5)

		return
	}

	c.Sleep(10)
}

// --------------------------------------------------------------- HellMeteor

// thinkHellMeteor is MONAI_Think_HellMeteor 0x5f4820 (VERIFIED, disassembled):
// with Skill1 and chance aip1 it casts it at a random point within aip3
// subtiles of itself (x then y, each roll(2*aip3) - aip3), else sleeps aip2.
func thinkHellMeteor(c *Ctx) {
	b := c.B

	if c.skill(slotA) && b.Chance(b.AIP(1)) {
		r := b.AIP(3)
		x := b.X + b.Roll(2*r) - r
		y := b.Y + b.Roll(2*r) - r

		c.Cast(slotA, Target{X: x, Y: y})

		return
	}

	c.Sleep(b.AIP(2))
}

// -------------------------------------------------------------------- Hydra

// thinkHydra is MONAI_Think_Hydra 0x5e8f10 (VERIFIED). Scratch[0] is the
// expiry frame the summoning skill writes; the exe never reaches a think with
// it unset, so 0 is read as "no expiry given" here. Dies when it has passed,
// else fires Skill1 at a target closer than 25 with 60%, else sleeps 10.
func thinkHydra(c *Ctx) {
	b := c.B

	if b.Scratch[0] != 0 && b.Scratch[0] < c.frame() {
		c.die()

		return
	}

	if c.Target != nil && c.Dist < 25 && b.Chance(60) {
		c.Cast(slotA, *c.Target)

		return
	}

	c.Sleep(10)
}

// ---------------------------------------------------------------- InvisoPet

// invisoPetSkill is the fixed skill the pet casts (0x124, mode S2; VERIFIED
// immediates).
const invisoPetSkill = 0x124

// thinkInvisoPet is MONAI_Think_InvisoPet 0x5e9810 (VERIFIED). Scratch[0] is
// the frame of the next cast. aip1 scatter radius (halved while the leader is
// in mode 3), aip2 delay between casts. The leader's position stands for the
// exe's MONAI_GetLeaderUnit.
func thinkInvisoPet(c *Ctx) {
	b := c.B
	l := b.Leader

	if l == nil {
		c.Sleep(25)

		return
	}

	r := b.AIP(1)
	if l.Mode == 3 {
		r /= 2
	}

	if c.frame() <= b.Scratch[0] && l.Mode != 3 && !b.Aggressive {
		c.Sleep(b.AIP(2))

		return
	}

	x := b.Roll(r*2) - r + l.X
	y := b.Roll(r*2) - r + l.Y

	if sc, ok := c.W.(SkillCaster); ok && sc.CastSkillAt(b, invisoPetSkill, ModeSkill2, Point{x, y}) {
		c.busy()
	}

	b.Scratch[0] = b.AIP(2) + c.frame()
}

// ---------------------------------------------------------------- MaggotEgg

// thinkMaggotEgg is MONAI_Think_MaggotEgg 0x5f5620 (VERIFIED). Scratch[0] 1
// once the hatch skill was cast; the next think removes the egg. aip1 stall,
// aip2 hatch %.
func thinkMaggotEgg(c *Ctx) {
	b := c.B
	s := &b.Scratch

	if c.skill(slotA) && s[0] != 1 {
		if b.Chance(b.AIP(2)) {
			c.Cast(slotA, faTarget(c))
			c.Sleep(b.AIP(1))

			s[0] = 1

			return
		}
	}

	if s[0] == 1 {
		// COMBAT_ServerHandleUnitDeath(PATH_GetTargetUnitExcludingSelf(..), 1);
		// the unit it kills is taken to be the egg itself (UNVERIFIED)
		c.die()
	}

	c.Sleep(b.AIP(1))
}

// -------------------------------------------------------------- MaggotLarva

// thinkMaggotLarva is MONAI_Think_MaggotLarva 0x5f5330 (VERIFIED). Scratch[0]
// is "just attacked". aip1 attack %, aip2 stall after, aip3 approach %,
// aip4 stall when idle.
func thinkMaggotLarva(c *Ctx) {
	b, t := c.B, *c.Target
	s := &b.Scratch

	if !c.InRange {
		s[0] = 0

		if b.Chance(b.AIP(3)) {
			c.WalkTo(t, 1)

			return
		}

		c.Sleep(b.AIP(4))

		return
	}

	if s[0] == 0 && b.Chance(b.AIP(1)) {
		s[0] = 1
		c.Attack(ModeAttack1, t)

		return
	}

	s[0] = 0
	c.Sleep(b.AIP(2))
}

// ------------------------------------------------------------ MinionSpawner

// thinkMinionSpawner is MONAI_Think_MinionSpawner 0x5e1ab0 with the shared
// spawner pre-hook (VERIFIED). Scratch[0] frame of the next cast, Scratch[1]
// casts done. aip1 cast limit, aip2 minion cap and stall, aip3 cast gap,
// aip4 wake range. Once the limit is reached the exe schedules nothing (the
// tick's own 10-frame fallback applies).
func thinkMinionSpawner(c *Ctx) {
	b, t := c.B, faTarget(c)
	s := &b.Scratch

	c.pre(func() { s[0], s[1] = c.frame(), 0 })

	if s[1] >= b.AIP(1) {
		return
	}

	if c.Dist > b.AIP(4) || c.frame() < s[0] {
		c.Sleep(b.AIP(2))

		return
	}

	n := 0
	if m, ok := c.W.(MinionCounter); ok {
		n = m.CountMinions(b)
	}

	if c.skill(slotA) && n < b.AIP(2) {
		s[1]++
		s[0] = b.AIP(3) + c.frame()

		c.Cast(slotA, t)

		return
	}

	c.Sleep(b.AIP(2))
}

// ----------------------------------------------------------------- Mosquito

// thinkMosquito is MONAI_Think_Mosquito 0x5f2700 (VERIFIED). Scratch[0] is
// the phase (0 chase, 1 buzz around, 2 retreat), Scratch[1] its counter.
// aip3 attack %, aip4 skill %, aip5 buzz ticks.
func thinkMosquito(c *Ctx) {
	b, t := c.B, *c.Target
	s := &b.Scratch

	if c.InRange {
		if b.Roll(100) < b.AIP(3) || s[1] == 0 {
			s[1]++

			if c.skill(slotA) && b.Roll(100) < b.AIP(4) {
				c.Cast(slotA, t)

				return
			}

			c.Attack(ModeAttack1, t)

			return
		}

		if b.Roll(100) > 20 {
			c.Sleep(15)

			return
		}

		s[0], s[1] = 2, 0
	}

	switch s[0] {
	case 0:
		c.SetSpeed(100)
		c.WalkTo(t, 0)
	case 1:
		c.SetSpeed(50)
		c.Wander(4)

		s[1]++
		if b.AIP(5) < s[1] {
			s[0], s[1] = 0, 0
		}
	case 2:
		c.SetSpeed(100)
		c.WalkAway(t, 10, true)

		s[0], s[1] = 1, 0
	default:
		s[0], s[1] = 0, 0

		c.Sleep(10)
	}
}

// ------------------------------------------------------------- MosquitoNest

// thinkMosquitoNest is MONAI_Think_MosquitoNest 0x5df080 with the shared
// spawner pre-hook (VERIFIED). aip1 spawn limit, aip2 wake range, aip3 gap.
func thinkMosquitoNest(c *Ctx) {
	b, t := c.B, faTarget(c)
	s := &b.Scratch

	c.pre(func() { s[0], s[1] = c.frame(), 0 })

	if c.Dist <= b.AIP(2) {
		if b.AIP(1) < s[1] {
			c.die()

			return
		}

		if c.skill(slotA) && s[0] < c.frame() && c.spawnSpace() {
			s[1]++
			s[0] = b.AIP(3) + c.frame()

			c.Cast(slotA, t)

			return
		}
	}

	c.Sleep(25)
}

// --------------------------------------------------------------- 7TIllusion

// think7TIllusion is MONAI_Think_7TIllusion 0x5e9130 (VERIFIED): the first
// think walks-attacks toward (x-10, y), the second removes the illusion.
func think7TIllusion(c *Ctx) {
	b := c.B

	if b.Scratch[1] == 1 {
		c.die()

		return
	}

	c.Attack(ModeAttack1, Target{X: b.X - 10, Y: b.Y})

	b.Scratch[1] = 1
}

// ------------------------------------------------------------------ Ancients

// The Ancient AIs run for the three class ids of the Rite of Passage fight.
const (
	ancientA = 0x21c
	ancientB = 0x21d
	ancientC = 0x21e
)

func (c *Ctx) ancientBusy() bool {
	if r, ok := c.W.(RiteOfPassage); ok {
		return r.AncientFightActive()
	}

	return false
}

// ancientTarget is MONAI_Diablo_FindBestTarget (callback 0x5edc20): the port
// uses the shared attack-target scan (UNVERIFIED filter).
func ancientTarget(c *Ctx) (Target, int, bool) {
	if c.Target != nil {
		return *c.Target, c.Dist, true
	}

	return c.W.AttackTarget(c.B)
}

// thinkAncient is MONAI_Think_Ancient 0x5ee290: the class picks the state
// function, any other class does nothing (the exe returns without a wait).
func thinkAncient(c *Ctx) {
	switch c.B.Class {
	case ancientA:
		ancientStateA(c)
	case ancientB:
		ancientStateB(c)
	case ancientC:
		ancientStateC(c)
	}
}

// ancientStateA is 0x5edc80 (VERIFIED): a charge that casts Skill1 past the
// target, otherwise melee. aip1 skill range, aip2 skill %, aip3 attack %,
// aip4 overshoot distance.
func ancientStateA(c *Ctx) {
	b := c.B

	if c.ancientBusy() || c.W.HasState(b, 0x36) {
		c.Sleep(25)

		return
	}

	t, d, ok := ancientTarget(c)
	if !ok {
		c.Sleep(25)

		return
	}

	melee := c.W.InRange(b, t, d)

	if c.skill(slotA) && d < b.AIP(1) && b.Roll(100) < b.AIP(2) {
		dx, dy := t.X-b.X, t.Y-b.Y

		full := Distance(dx, dy)
		if full == 0 {
			full = 1
		}

		o := b.AIP(4)
		c.Cast(slotA, Target{X: t.X + o*dx/full, Y: t.Y + o*dy/full})

		return
	}

	if !melee {
		c.walkNoTarget(t)
		c.Sleep(10)

		return
	}

	if b.Chance(b.AIP(3)) {
		if b.Roll(2) != 0 {
			c.Attack(ModeAttack1, t)
		} else {
			c.Attack(ModeAttack2, t)
		}

		return
	}

	c.Sleep(25)
}

// ancientStateB is 0x5edeb0 (VERIFIED): a kiting archer-caster. aip1 keep
// range, aip2 A1 %, aip3 skill %, aip4 back-off %, aip5 back-off distance.
// The two skill-state exclusion tests of the exe (skills.txt states on the
// caster and the target) are not ported.
func ancientStateB(c *Ctx) {
	b := c.B

	t, d, ok := ancientTarget(c)
	if c.ancientBusy() || !ok {
		c.Sleep(25)

		return
	}

	melee := c.W.InRange(b, t, d)

	if melee && b.Roll(100) < b.AIP(4) && c.WalkAway(t, b.AIP(5), true) {
		c.Sleep(25)

		return
	}

	if c.skill(slotA) && b.Roll(100) < b.AIP(3) && c.Cast(slotA, c.self()) {
		return
	}

	if d < b.AIP(1) && b.Roll(100) < b.AIP(2) && c.Attack(ModeAttack1, t) {
		return
	}

	if d < b.AIP(1) || !c.WalkTo(t, d-b.AIP(1)) {
		c.Sleep(10)
	}
}

// ancientStateC is 0x5ee110 (VERIFIED): melee with a Skill1 at range. aip1
// skill range, aip2 skill %, aip3 attack %.
func ancientStateC(c *Ctx) {
	b := c.B

	if c.ancientBusy() {
		c.Sleep(25)

		return
	}

	t, d, ok := ancientTarget(c)
	if !ok {
		c.Sleep(25)

		return
	}

	melee := c.W.InRange(b, t, d)

	if c.skill(slotA) && d < b.AIP(1) && b.Roll(100) < b.AIP(2) {
		c.Cast(slotA, t)

		return
	}

	if !melee {
		c.walkNoTarget(t)
		c.Sleep(10)

		return
	}

	if b.Chance(b.AIP(3)) {
		if b.Roll(2) != 0 {
			c.Attack(ModeAttack1, t)
		} else {
			c.Attack(ModeAttack2, t)
		}

		return
	}

	c.Sleep(25)
}

// ancientStatueSkill is the skill the statue casts once the fight is won
// (0x12e, mode A1; VERIFIED immediates).
const (
	ancientStatueSkill = 0x12e
	ancientStatueState = 0x92
)

// thinkAncientStatue is MONAI_Think_AncientStatue 0x5edbb0 (VERIFIED): once
// the Rite of Passage fight is done and no portal exists yet, a statue without
// state 0x92 casts skill 0x12e on itself; else waits 25.
func thinkAncientStatue(c *Ctx) {
	b := c.B

	if r, ok := c.W.(RiteOfPassage); ok && r.FightDone() && r.PortalCount() == 0 &&
		!c.W.HasState(b, ancientStatueState) {
		if sc, ok := c.W.(SkillCaster); ok && sc.CastSkillAt(b, ancientStatueSkill, ModeAttack1, Point{b.X, b.Y}) {
			c.busy()

			return
		}
	}

	c.Sleep(25)
}
